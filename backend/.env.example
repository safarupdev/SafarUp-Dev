# Server
PORT=4000
NODE_ENV=development

# CORS — public and admin app origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Client URLs — used to build links inside transactional emails
PUBLIC_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174

# MongoDB — PRD §10, §93. Use a separate database per environment.
MONGODB_URI=mongodb://127.0.0.1:27017/safarup-dev

# JWT secrets — PRD §30, §95. Generate strong random values, never reuse
# across environments. Example: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Password hashing cost factor (bcrypt)
BCRYPT_SALT_ROUNDS=12

# Cookie domain — leave unset for localhost; set to ".safarup.in" in production
# so the cookie is shared between safarup.in and admin.safarup.in.
COOKIE_DOMAIN=

# SMTP — PRD §14. If unset in development, emails are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SafarUp <no-reply@safarup.in>

# Razorpay — PRD §12–13, §94. Populated when the payment/booking phase begins.
RAZRPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=