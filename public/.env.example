# Base URL of the backend API (PRD §8: safarup.in talks to the backend)
VITE_API_BASE_URL=http://localhost:4000/api

# Absolute origin used for canonical URLs, Open Graph URLs and JSON-LD `@id`s
# (API.destination.contract.md §2.2 requires canonical URLs to be absolute).
# It is deliberately NOT derived from window.location: a staging deploy must
# not tell a crawler the production page lives on staging.
VITE_SITE_URL=https://safarup.in
